# One key for both the chat model and Jev.
FUTUREX_API_KEY=

# OpenAI-compatible root, including /v1.
# The chat client calls {FUTUREX_BASE_URL}/chat/completions.
FUTUREX_BASE_URL=https://your-gateway.example/v1

# TypeSafe root, no /v1. The SDK calls {JEV_BASE_URL}/v1/systemone.
# The same gateway host is fine.
JEV_BASE_URL=https://your-gateway.example
JEV_MODEL=jev-latest

# Chat model id served by the gateway.
CHAT_MODEL=gpt-4o

# Separate key from https://firecrawl.dev — required for hunts.
FIRECRAWL_API_KEY=
